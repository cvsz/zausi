# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# --- OpenCode CLI (see Makefile opencode-* targets) ---
# Provider credentials: load keys here or via `opencode auth login`.
# Never commit real values; this file is a template only.
# NVIDIA_API_KEY=nvapi-replace-me            # NVIDIA Nemotron / NIM (OpenAI-compatible: https://integrate.api.nvidia.com/v1)
# OPENCODE_FREE_MODEL=opencode/ilm-model-lite  # model used by make opencode-free-* targets
# OPENCODE_AUTO_APPROVE=deny                  # ask | allow | deny for non-interactive runs
